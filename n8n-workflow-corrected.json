            {
              "name": "content-type",
              "value": "application/json"
            },
            {
              "name": "x-api-key",
              "value": "={{ $env.HEYGEN_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  video_inputs: [{\n    character: {\n      type: 'talking_photo',\n      talking_photo_id: '1d53feb67c68487cad5fb575af7850ec',\n      avatar_style: 'normal'\n    },\n    voice: {\n      type: 'text',\n      input_text: $json.body.script?.talking_points || 'Hello from Celebrity!',\n      voice_id: '7c254a78d61b4b34a05913701f996b72',\n      speed: 1.0\n    }\n  }],\n  dimension: { width: 1280, height: 720 }\n}) }}",
        "options": {}
      },
      "id": "generate-video",
